export ZSH="$HOME/.oh-my-zsh"
export VISUAL=vim
export EDITOR="$VISUAL"

ZSH_THEME="agnoster"
DEFAULT_USER="$USER"
plugins=(git fzf)

if [[ -d "$HOME/.fzf/bin" ]]; then
  path=("$HOME/.fzf/bin" $path)
fi

if [[ -f "$ZSH/oh-my-zsh.sh" ]]; then
  source "$ZSH/oh-my-zsh.sh"
fi

bindkey \^U backward-kill-line
setopt nonomatch
